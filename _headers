/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: geolocation=(), payment=(), usb=(), camera=(), microphone=(), clipboard-read=(), clipboard-write=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://*.zdassets.com; connect-src 'self' https://*.zendesk.com https://*.zdassets.com; style-src 'self' 'unsafe-inline' https://*.zdassets.com; img-src 'self' data: https://*.zdassets.com; font-src 'self' data: https://*.zdassets.com; frame-src https://*.zendesk.com https://*.zdassets.com; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow

/index.html
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/widget-init.js
  Cache-Control: no-cache

/style.css
  Cache-Control: no-cache
